{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Deliberately NOT wrangler's generated `worker-configuration.d.ts`: a
    // published package cannot reference a consumer's ambient `Env`. Core
    // declares its own env slices in `src/env.ts`, so a stray `Env` reference
    // fails typecheck here rather than at a consumer's build.
    // The one permitted exception is the *namespaced* `Cloudflare.Env`, which is
    // not the same thing: `@cloudflare/workers-types` declares it as an empty
    // `interface Env {}` that `wrangler types` augments in the consumer, and the
    // Agents SDK constrains its own base class to it
    // (`class Agent<Env extends Cloudflare.Env = Cloudflare.Env>`). So
    // `RecipeSubagentBase` in `src/subagent/index.ts` must mirror that
    // constraint — dropping it fails with "Type 'TEnv' does not satisfy the
    // constraint 'Env'". Bare `Env` stays forbidden; `Cloudflare.Env` is a
    // declaration-merging seam, not a reference to a generated file.
    // `@cloudflare/vitest-pool-workers/types` is here for `src/testing/*`, which
    // imports `cloudflare:test`. That subpath is only ever loaded from a test
    // run, and a consumer of `@looping/core/testing` has the pool installed by
    // definition — nothing in the runtime graph reaches it.
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // Everything under `src/`, specs included. Specs are deliberately NOT excluded
  // here: eslint's type-aware pass resolves each file to its *nearest* tsconfig,
  // so a co-located spec excluded from this project has no project at all and
  // fails to parse. `tsconfig.build.json` is where specs get held out of `dist`.
  "include": ["src/**/*.ts"]
}
