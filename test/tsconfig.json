{
  // The test-side project. Separate from the root config because tests may see
  // things `src/` deliberately cannot — chiefly the `cloudflare:test` module.
  // `npm run check` typechecks both projects, so a spec that drifts from the
  // source fails the build.
  //
  // `worker-configuration.d.ts` is included but **not** guaranteed to exist:
  // it is generated by `npm run types` and gitignored, so a clean checkout does
  // not have it and `check` does not create it. That is fine rather than a gap.
  // `Cloudflare.Env` resolves either way — `@cloudflare/workers-types` declares
  // it as an empty `interface Env {}`, and `wrangler types` only *augments* that
  // with this config's bindings. Nothing in the test host reads a specific
  // binding off it (`test/worker.ts` only passes it as a type argument, and
  // `db.spec.ts` casts to the namespace it needs), so the typecheck is the same
  // with or without the generated file. Run `npm run types` if you want the real
  // bindings to be checked.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ]
  },
  // Only the test host and the build config. Specs co-located under `src/` are
  // covered by the root project — see the note there about eslint's resolution.
  "include": [
    "./**/*.ts",
    "../vitest.config.ts",
    "../worker-configuration.d.ts"
  ]
}
