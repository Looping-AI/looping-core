{
  "name": "@loopingai/core",
  "version": "0.1.0",
  "description": "Shared, mandatory foundation for Looping agents on Cloudflare Workers: zero-trust A2A, durable task lifecycle, delegation and subagent runtime, test harness.",
  "keywords": [
    "a2a",
    "agent2agent",
    "ai-agents",
    "cloudflare-workers",
    "durable-objects",
    "agents-sdk",
    "zero-trust",
    "jwks",
    "eddsa",
    "workflows"
  ],
  "license": "GPL-3.0-only",
  "author": "Looping AI",
  "homepage": "https://github.com/Looping-AI/looping-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Looping-AI/looping-core.git"
  },
  "bugs": {
    "url": "https://github.com/Looping-AI/looping-core/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "looping-keys": "scripts/generate-keys.mjs"
  },
  "files": [
    "dist",
    "eslint-rules",
    "scripts/generate-keys.mjs",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./subtasks": {
      "types": "./dist/subtasks/index.d.ts",
      "import": "./dist/subtasks/index.js"
    },
    "./subagent": {
      "types": "./dist/subagent/index.d.ts",
      "import": "./dist/subagent/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/node": {
      "types": "./dist/testing/node.d.ts",
      "import": "./dist/testing/node.js"
    },
    "./testing/vcr-global-setup": {
      "types": "./dist/testing/vcr-global-setup.d.ts",
      "import": "./dist/testing/vcr-global-setup.js"
    },
    "./eslint": "./eslint-rules/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate && node scripts/build-migrations.mjs",
    "keys": "node scripts/generate-keys.mjs",
    "types": "wrangler types",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && eslint . && tsc && tsc -p test/tsconfig.json && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "prepack": "npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check && npm test && npm run verify:exports"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "agents": "^0.20.0",
    "ai": "^7.0.40",
    "undici": ">=8",
    "vitest": ">=4",
    "workers-ai-provider": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@types/node": "^26.1.1",
    "agents": "^0.20.0",
    "ai": "^7.0.40",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "undici": "8.9.0",
    "vitest": "^4.1.10",
    "workers-ai-provider": "^4.0.0",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "sharp": false,
    "workerd": false,
    "core-js-pure": false
  }
}
